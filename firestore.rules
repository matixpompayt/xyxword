rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email == 'admin@xyxword.game'; }
    // zapis gry gracza
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // podsumowanie gracza dla panelu admina
    match /stats/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    // budynki gracza widoczne na mapie dla innych (czytają wszyscy, zapisuje właściciel)
    match /bld/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // miejscowości dodane przez admina: czytają wszyscy, zapisuje tylko admin
    match /places/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
