rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // każdy gracz czyta i zapisuje tylko swój dokument (zapis gry)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // miejscowości dodane przez admina: czytają wszyscy, zapisuje tylko admin
    match /places/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@xyxword.game';
    }
  }
}
